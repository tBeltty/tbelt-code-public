{
  "name": "@deepseek-ai/dsh-terminal-views",
  "description": "Pure terminal views: transcript, tool lines, composer, approval prompt and session choice for the terminal client",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/terminal-client/views"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-presentation-approval": "workspace:*",
    "@deepseek-ai/dsh-presentation-tool-call": "workspace:*",
    "@deepseek-ai/dsh-presentation-tool-card": "workspace:*",
    "@deepseek-ai/dsh-util-workspace-path": "workspace:*",
    "get-east-asian-width": "^1.6.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*"
  }
}
